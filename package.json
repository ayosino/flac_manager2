{
  "name": "flac-manager2",
  "version": "2.0.0",
  "description": "Self-hosted FLAC Music Manager (Theatre of Eternal Music)",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "build": "npm --prefix client run build",
    "dev:client": "npm --prefix client run dev",
    "scan": "node server/scripts/scanner.js",
    "scan:full": "node server/scripts/scanner.js --full",
    "init-db": "node server/scripts/initDb.js",
    "setup": "npm install && npm --prefix client install && npm run build"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "faiss-node": "^0.5.1",
    "kuromoji": "^0.1.2",
    "music-metadata": "^11.12.3",
    "mysql2": "^3.20.0",
    "wanakana": "^5.3.1"
  }
}
